            radial-gradient(120% 80% at 50% 50%, rgba(0,0,0,0) 55%, rgba(0,0,0,0.35) 100%),
            linear-gradient(180deg, rgba(9,9,11,0.55) 0%, rgba(9,9,11,0) 22%, rgba(9,9,11,0) 78%, rgba(9,9,11,0.55) 100%);"></div>
          <!-- Floating overlay stats -->
          <div class="pointer-events-none absolute inset-0 flex flex-col justify-between p-5">
            <div class="flex items-start justify-between gap-4">
              <div class="rounded-lg border border-white/[0.06] bg-zinc-950/55 px-3.5 py-2.5 backdrop-blur-md">
                <div class="flex items-center gap-2">
                  <div class="text-[10.5px] font-semibold uppercase tracking-[0.08em] text-zinc-400">Aetheron Vela SC</div>
                  <span class="rounded-sm border border-white/10 bg-white/[0.04] px-1.5 py-0.5 font-mono text-[9.5px] uppercase tracking-wider text-zinc-400">N3E</span>
                </div>
