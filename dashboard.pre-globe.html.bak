<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Kiln — Fab Floor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: { extend: { fontFamily: {
      sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
      mono: ['JetBrains Mono', 'ui-monospace', 'SFMono-Regular', 'Menlo', 'monospace'],
    } } },
  }
</script>
</head>
<body class="bg-white text-zinc-950 antialiased">

<div class="grid h-screen grid-cols-[232px_1fr]">

  <!-- ============ Sidebar ============ -->
  <aside class="flex h-full flex-col border-r border-zinc-200 bg-white">
    <div class="flex items-center gap-2 px-5 pt-5 pb-4">
      <span class="grid h-6 w-6 place-items-center rounded-md bg-zinc-900 text-[12px] font-bold text-white">K</span>
      <span class="text-[15px] font-semibold tracking-tight">Kiln</span>
    </div>

    <button class="mx-3 mb-3 flex items-center gap-2.5 rounded-md border border-zinc-200 px-2.5 py-2 text-left transition hover:bg-zinc-50">
      <span class="grid h-6 w-6 place-items-center rounded-full bg-zinc-200 text-[11px] font-semibold text-zinc-700">F1</span>
      <span class="flex-1 truncate text-[13px] font-medium text-zinc-800">Fab 1 · Austin</span>
      <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 text-zinc-400" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 9l4-4 4 4M8 15l4 4 4-4"/></svg>
    </button>

    <nav class="flex-1 overflow-y-auto px-2">
      <ul class="space-y-0.5 text-[13px]">
        <li><span aria-current="page" class="flex items-center gap-2.5 rounded-md bg-zinc-100 px-2.5 py-1.5 font-medium text-zinc-900 cursor-default">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Fab Floor
        </span></li>
        <li><a href="tools.html" class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-900">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.8-2.8z"/></svg>
          Tool Fleet
        </a></li>
        <li><a href="recipe.html" class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-900">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M8 6h8M7 7l4 9M17 7l-4 9"/></svg>
          Recipes
        </a></li>
        <li><a href="lot-detail.html" class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-900">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg>
          Wafer Lots
        </a></li>
        <li><a href="bom.html" class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-900">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4"/></svg>
          Process BOM
        </a></li>
        <li><a href="vendors.html" class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-900"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7l9-4 9 4v10l-9 4-9-4z"/><path d="M3 7l9 4 9-4M12 11v10"/></svg>Vendors</a></li>
        <li><a href="comms.html" class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-900"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.14L3 21l1.86-6.4A8 8 0 1 1 21 12z"/></svg>Comms</a></li>
        <li><a href="#" class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-900">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3v18h18"/><path d="M7 14l4-4 4 4 5-6"/></svg>
          Yield Insights
        </a></li>
        <li><a href="#" class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-900">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10.3 3.3a2 2 0 0 1 3.4 0l8 14a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3z"/><path d="M12 9v4M12 17h.01"/></svg>
          Hazmat &amp; DG
        </a></li>
        <li><a href="#" class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-900">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          Team
        </a></li>
        <li><a href="#" class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-900">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3h0a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5h0a1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8v0a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
          Settings
        </a></li>
      </ul>
    </nav>

    <div class="flex items-center gap-2.5 border-t border-zinc-200 px-3 py-3">
      <span class="grid h-7 w-7 place-items-center rounded-full bg-zinc-900 text-[11px] font-semibold text-white">CM</span>
      <span class="text-[13px] font-medium text-zinc-800">C. Mesbah</span>
    </div>
  </aside>

  <!-- ============ Main ============ -->
  <main class="overflow-y-auto">
    <div class="mx-auto w-full max-w-[1320px] px-6 pb-16 pt-8 lg:px-12 xl:px-16">

      <!-- Hero -->
      <header class="mb-7 flex items-center justify-between gap-8">
        <div class="min-w-0">
          <h1 class="text-3xl font-semibold tracking-tight text-zinc-950">Fab Floor</h1>
          <p class="mt-2 max-w-2xl text-[15px] leading-relaxed text-zinc-500">A live snapshot of what's running and what needs your attention — every tool, lot, and supply line in Fab 1, on one page.</p>
        </div>
        <!-- Decorative isometric: wafer disk → diced wafer → packaged chip -->
        <svg viewBox="0 0 240 80" class="hidden h-auto w-[220px] flex-shrink-0 lg:block" aria-hidden="true">
          <defs>
            <clipPath id="fabHeroDiceClip">
              <ellipse cx="0" cy="-2" rx="22" ry="11"/>
            </clipPath>
          </defs>
          <g fill="none" stroke="rgb(161 161 170)" stroke-width="1.25" stroke-linecap="round">
            <path d="M 64 36 L 96 36"/>
            <path d="M 144 36 L 176 36"/>
          </g>
          <!-- 1: Wafer disk (silvery) -->
          <g transform="translate(40 36)">
            <ellipse cx="0" cy="0" rx="22" ry="11" fill="rgb(244 244 245)" stroke="rgb(113 113 122)" stroke-width="1.2"/>
            <ellipse cx="0" cy="-2" rx="22" ry="11" fill="rgb(250 250 250)" stroke="rgb(113 113 122)" stroke-width="1.2"/>
            <path d="M -10 -6 L -8 -3 M 10 -6 L 8 -3 M 0 -6 L 0 -2" stroke="rgb(161 161 170)" stroke-width="0.7"/>
            <path d="M -16 -3 L 16 -3 M -14 0 L 14 0" stroke="rgb(212 212 216)" stroke-width="0.6"/>
          </g>
          <!-- 2: Diced wafer / die grid (steel blue) — same disc convention as #1,
               diced into a grid rather than switched to a boxy isometric prism. -->
          <g transform="translate(120 36)">
            <ellipse cx="0" cy="0" rx="22" ry="11" fill="rgb(203 219 240)" stroke="rgb(71 85 105)" stroke-width="1.2"/>
            <ellipse cx="0" cy="-2" rx="22" ry="11" fill="rgb(226 236 250)" stroke="rgb(71 85 105)" stroke-width="1.2"/>
            <g clip-path="url(#fabHeroDiceClip)" stroke="rgb(148 163 184)" stroke-width="0.55">
              <path d="M -22 -8 H 22 M -22 -4 H 22 M -22 0 H 22 M -22 4 H 22"/>
              <path d="M -15 -13 V 9 M -7.5 -13 V 9 M 0 -13 V 9 M 7.5 -13 V 9 M 15 -13 V 9"/>
            </g>
            <rect x="-3.5" y="-5.5" width="7" height="4" fill="rgb(59 130 246)" opacity="0.55"/>
          </g>
          <!-- 3: Packaged chip (copper pads) — same disc convention as #1/#2 -->
          <g transform="translate(200 36)">
            <ellipse cx="0" cy="0" rx="22" ry="11" fill="rgb(254 215 170)" stroke="rgb(194 65 12)" stroke-width="1.2"/>
            <ellipse cx="0" cy="-2" rx="22" ry="11" fill="rgb(255 237 213)" stroke="rgb(194 65 12)" stroke-width="1.2"/>
            <g clip-path="url(#fabHeroDiceClip)" fill="rgb(194 65 12)">
              <circle cx="-10" cy="-6"   r="1.1"/>
              <circle cx="-3"  cy="-7"   r="1.1"/>
              <circle cx="4"   cy="-6.5" r="1.1"/>
              <circle cx="11"  cy="-6"   r="1.1"/>
              <circle cx="-10" cy="-2"   r="1.1"/>
              <circle cx="-3"  cy="-2.5" r="1.1"/>
              <circle cx="4"   cy="-2"   r="1.1"/>
              <circle cx="11"  cy="-2"   r="1.1"/>
            </g>
          </g>
        </svg>
      </header>
      <hr class="mb-8 border-zinc-200" />

      <!-- KPI strip -->
      <div class="mb-8 grid grid-cols-2 gap-3 lg:grid-cols-4">
        <div class="rounded-lg border border-zinc-200 bg-white px-5 py-4">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">WIP</div>
          <div class="mt-1.5 flex items-baseline gap-2">
            <span class="text-[24px] font-semibold tabular-nums tracking-tight text-zinc-950">14,206</span>
            <span class="text-[12px] tabular-nums text-zinc-500">wafers</span>
          </div>
          <div class="mt-1 text-[12px] tabular-nums text-emerald-700">+482 vs last week</div>
          <svg viewBox="0 0 80 22" class="mt-2 h-[22px] w-full" preserveAspectRatio="none" aria-hidden="true">
            <polyline points="2,18 12,15 22,16 32,12 42,11 52,8 62,9 72,5 78,4" fill="none" stroke="rgb(24 24 27)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="78" cy="4" r="1.8" fill="rgb(24 24 27)"/>
          </svg>
        </div>
        <div class="rounded-lg border border-zinc-200 bg-white px-5 py-4">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Weekly outs</div>
          <div class="mt-1.5 flex items-baseline gap-2">
            <span class="text-[24px] font-semibold tabular-nums tracking-tight text-zinc-950">3,180</span>
            <span class="text-[12px] tabular-nums text-zinc-500">wafers</span>
          </div>
          <div class="mt-1 text-[12px] tabular-nums text-zinc-500">94% of plan (3,400)</div>
          <svg viewBox="0 0 80 22" class="mt-2 h-[22px] w-full" preserveAspectRatio="none" aria-hidden="true">
            <rect x="2"  y="10" width="8" height="12" rx="1" fill="rgb(212 212 216)"/>
            <rect x="13" y="6"  width="8" height="16" rx="1" fill="rgb(212 212 216)"/>
            <rect x="24" y="8"  width="8" height="14" rx="1" fill="rgb(212 212 216)"/>
            <rect x="35" y="4"  width="8" height="18" rx="1" fill="rgb(212 212 216)"/>
            <rect x="46" y="9"  width="8" height="13" rx="1" fill="rgb(212 212 216)"/>
            <rect x="57" y="5"  width="8" height="17" rx="1" fill="rgb(212 212 216)"/>
            <rect x="68" y="7"  width="8" height="15" rx="1" fill="rgb(24 24 27)"/>
          </svg>
        </div>
        <div class="rounded-lg border border-zinc-200 bg-white px-5 py-4">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Cycle time</div>
          <div class="mt-1.5 flex items-baseline gap-2">
            <span class="text-[24px] font-semibold tabular-nums tracking-tight text-zinc-950">62.4</span>
            <span class="text-[12px] tabular-nums text-zinc-500">days · N3E</span>
          </div>
          <div class="mt-1 text-[12px] tabular-nums text-amber-700">+1.8d vs target</div>
          <svg viewBox="0 0 80 22" class="mt-2 h-[22px] w-full" preserveAspectRatio="none" aria-hidden="true">
            <polyline points="2,16 12,15 22,14 32,13 42,11 52,10 62,8 72,6 78,4" fill="none" stroke="rgb(180 83 9)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="78" cy="4" r="1.8" fill="rgb(180 83 9)"/>
          </svg>
        </div>
        <div class="rounded-lg border border-zinc-200 bg-white px-5 py-4">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Line yield</div>
          <div class="mt-1.5 flex items-baseline gap-2">
            <span class="text-[24px] font-semibold tabular-nums tracking-tight text-zinc-950">91.2<span class="text-[16px] text-zinc-400">%</span></span>
          </div>
          <div class="mt-1 text-[12px] tabular-nums text-emerald-700">+0.4 pp WoW</div>
          <svg viewBox="0 0 80 22" class="mt-2 h-[22px] w-full" preserveAspectRatio="none" aria-hidden="true">
            <polyline points="2,12 12,11 22,13 32,10 42,11 52,9 62,8 72,6 78,5" fill="none" stroke="rgb(4 120 87)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="78" cy="5" r="1.8" fill="rgb(4 120 87)"/>
          </svg>
        </div>
      </div>

      <!-- Attention cards -->
      <section class="mb-10">
        <h2 class="mb-3 text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Needs your attention now</h2>
        <div class="grid grid-cols-1 gap-3 lg:grid-cols-3">

          <!-- CRIT: tool down -->
          <article class="flex flex-col gap-2 rounded-lg border border-zinc-200 bg-white p-5 shadow-sm transition hover:-translate-y-px hover:shadow-md">
            <div class="flex items-center gap-1.5 text-[10.5px] font-bold uppercase tracking-[0.06em] text-red-700">
              <span class="h-1.5 w-1.5 rounded-full bg-red-700"></span>
              Critical
            </div>
            <h3 class="text-[15px] font-semibold leading-snug tracking-tight text-zinc-950">Litho Track 3 down · 6h unscheduled</h3>
            <p class="text-[13px] leading-relaxed text-zinc-600">
              <span class="rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-[11.5px] text-zinc-700">ASML NXE:3800E · NXE-02</span> reticle stage fault E14-22.
              <strong class="font-medium text-zinc-900">8 lots quarantined</strong>, redirected to NXE-01 (cap-constrained).
              Field service ETA <strong class="font-medium text-zinc-900">2026-06-12 18:30</strong>.
            </p>
            <div class="mt-auto flex items-center gap-3 pt-1">
              <a href="tool-detail.html" class="inline-flex items-center gap-1 rounded-md px-1.5 py-1 -mx-1.5 text-[13px] font-medium text-zinc-900 transition hover:bg-zinc-100">
                Open tool
                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 2l4 4-4 4"/></svg>
              </a>
              <a href="lot-detail.html" class="inline-flex items-center text-[13px] font-medium text-zinc-500 transition hover:text-zinc-900">View affected lots</a>
            </div>
          </article>

          <!-- WARN: yield excursion -->
          <article class="flex flex-col gap-2 rounded-lg border border-zinc-200 bg-white p-5 shadow-sm transition hover:-translate-y-px hover:shadow-md">
            <div class="flex items-center gap-1.5 text-[10.5px] font-bold uppercase tracking-[0.06em] text-amber-700">
              <span class="h-1.5 w-1.5 rounded-full bg-amber-700"></span>
              Excursion
            </div>
            <h3 class="text-[15px] font-semibold leading-snug tracking-tight text-zinc-950">Meridian M6 yield drop on M3 metal etch</h3>
            <p class="text-[13px] leading-relaxed text-zinc-600">
              <span class="rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-[11.5px] text-zinc-700">Lot W2614-N3</span> die yield <strong class="font-medium text-zinc-900">78%</strong> vs 92% target.
              KLA Surfscan SP7 flagged a <strong class="font-medium text-zinc-900">+3.2σ defect cluster</strong> on metal-3 etch.
              Recipe held pending integration eng review.
            </p>
            <div class="mt-auto flex items-center gap-3 pt-1">
              <a href="lot-detail.html" class="inline-flex items-center gap-1 rounded-md px-1.5 py-1 -mx-1.5 text-[13px] font-medium text-zinc-900 transition hover:bg-zinc-100">
                Open lot
                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 2l4 4-4 4"/></svg>
              </a>
              <a href="recipe.html" class="inline-flex items-center text-[13px] font-medium text-zinc-500 transition hover:text-zinc-900">View recipe step</a>
            </div>
          </article>

          <!-- GOOD: supply ETA -->
          <article class="flex flex-col gap-2 rounded-lg border border-zinc-200 bg-white p-5 shadow-sm transition hover:-translate-y-px hover:shadow-md">
            <div class="flex items-center gap-1.5 text-[10.5px] font-bold uppercase tracking-[0.06em] text-emerald-700">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-700"></span>
              Inbound
            </div>
            <h3 class="text-[15px] font-semibold leading-snug tracking-tight text-zinc-950">JSR EUV resist replenishment confirmed</h3>
            <p class="text-[13px] leading-relaxed text-zinc-600">
              <span class="rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-[11.5px] text-zinc-700">PR-EUV-7242 · 480 L</span> — covers <strong class="font-medium text-zinc-900">~14k wafers</strong>.
              Shipped Yokkaichi → Austin DC, ETA <strong class="font-medium text-zinc-900">2026-06-21</strong>.
              Buffer rises to <strong class="font-medium text-zinc-900">23 days</strong>.
            </p>
            <div class="mt-auto flex items-center gap-3 pt-1">
              <a href="bom.html" class="inline-flex items-center gap-1 rounded-md px-1.5 py-1 -mx-1.5 text-[13px] font-medium text-zinc-900 transition hover:bg-zinc-100">
                Open BOM line
                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 2l4 4-4 4"/></svg>
              </a>
              <a href="#" class="inline-flex items-center text-[13px] font-medium text-zinc-500 transition hover:text-zinc-900">Receiving log</a>
            </div>
          </article>

        </div>
      </section>

      <!-- Tool fleet snapshot -->
      <section class="mb-10">
        <div class="mb-3 flex items-end justify-between">
          <h2 class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Tool fleet snapshot</h2>
          <a href="tools.html" class="text-[12.5px] font-medium text-zinc-700 transition hover:text-zinc-950">View all 142 tools <span aria-hidden="true">→</span></a>
        </div>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">

          <!-- ASML EUV -->
          <a href="tool-detail.html" class="group rounded-lg border border-zinc-200 bg-white p-4 transition hover:border-zinc-300 hover:shadow-md">
            <div class="flex items-start justify-between gap-2">
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="grid h-9 w-9 flex-shrink-0 place-items-center rounded-md bg-gradient-to-br from-slate-100 to-slate-300 text-[10.5px] font-bold text-slate-700 ring-1 ring-inset ring-slate-200">NXE</span>
                <div class="min-w-0">
                  <div class="truncate text-[13px] font-semibold text-zinc-950">ASML NXE:3800E</div>
                  <div class="text-[11px] text-zinc-500">EUV Litho · Bay 1</div>
                </div>
              </div>
