              </div>
              <div class="flex divide-x divide-white/[0.06] overflow-hidden rounded-lg border border-white/[0.06] bg-zinc-950/55 backdrop-blur-md">
                <div class="px-4 py-2.5 text-right">
                  <div class="text-[10px] font-semibold uppercase tracking-wider text-zinc-500">Nominal</div>
                  <div class="mt-0.5 font-mono text-[18px] font-semibold tabular-nums text-emerald-300">25</div>
                </div>
                <div class="px-4 py-2.5 text-right">
                  <div class="text-[10px] font-semibold uppercase tracking-wider text-zinc-500">Degraded</div>
                  <div class="mt-0.5 font-mono text-[18px] font-semibold tabular-nums text-amber-300">2</div>
                </div>
                <div class="px-4 py-2.5 text-right">
                  <div class="text-[10px] font-semibold uppercase tracking-wider text-zinc-500">Offline</div>
                  <div class="mt-0.5 font-mono text-[18px] font-semibold tabular-nums text-zinc-500">1</div>
                </div>
              </div>
            </div>
            <div class="flex items-end justify-between gap-4 text-[11px]">
              <div class="inline-flex items-center gap-2 rounded-md border border-white/[0.06] bg-zinc-950/55 px-3 py-1.5 font-mono tabular-nums text-zinc-300 backdrop-blur-md">
                <span class="h-1.5 w-1.5 rounded-full bg-cyan-400 shadow-[0_0_6px_rgba(34,211,238,0.7)]"></span>
                <span class="text-zinc-500">SC-1042</span>
                <span class="text-zinc-700">·</span>
                <span id="linkChipStatus">last contact 14s ago</span>
                <span class="text-zinc-700">·</span>
                <span id="linkChipGs" class="text-zinc-400">GS-Andøya</span>
