          <!-- Click-to-inspect card (hidden until a satellite / K-Anchor is picked) -->
          <div id="orbitCard" class="pointer-events-auto absolute right-5 top-24 hidden w-[268px] overflow-hidden rounded-lg border border-white/[0.08] bg-zinc-950/85 shadow-2xl ring-1 ring-inset ring-white/5 backdrop-blur-md">
            <div class="flex items-start justify-between gap-2 border-b border-white/[0.06] px-4 py-3">
              <div>
                <div id="orbitCardId" class="font-mono text-[13px] font-semibold tracking-tight text-zinc-100">—</div>
                <div id="orbitCardKind" class="mt-0.5 text-[10.5px] font-semibold uppercase tracking-wider text-zinc-500">—</div>
              </div>
              <button id="orbitCardClose" class="rounded p-1 text-zinc-500 hover:bg-white/[0.06] hover:text-zinc-200" aria-label="Close">
                <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3l10 10M13 3L3 13"/></svg>
              </button>
            </div>
            <div class="space-y-1.5 px-4 py-3 text-[11.5px]">
              <div class="flex items-center justify-between"><span class="text-zinc-500">Status</span><span id="orbitCardStatus">—</span></div>
              <div class="flex items-center justify-between"><span class="text-zinc-500">Silicon</span><span id="orbitCardSilicon" class="text-zinc-300">—</span></div>
              <div class="flex items-center justify-between"><span class="text-zinc-500">Altitude</span><span id="orbitCardAlt" class="font-mono tabular-nums text-zinc-300">—</span></div>
              <div class="flex items-center justify-between"><span class="text-zinc-500">Inclination</span><span id="orbitCardIncl" class="font-mono tabular-nums text-zinc-300">—</span></div>
              <div class="flex items-center justify-between"><span class="text-zinc-500">Uplink</span><span id="orbitCardUplink" class="font-mono tabular-nums text-zinc-300">—</span></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Active lots -->
      <section>
        <div class="mb-3 flex items-end justify-between">
          <h2 class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Active lots</h2>
          <a href="#" class="text-[12.5px] font-medium text-zinc-700 transition hover:text-zinc-950">All 326 lots <span aria-hidden="true">→</span></a>
        </div>
        <div class="overflow-hidden rounded-lg border border-zinc-200 bg-white">
          <table class="w-full text-left">
            <thead class="bg-zinc-50 text-[11px] font-semibold uppercase tracking-wider text-zinc-500">
              <tr>
                <th class="px-5 py-3">Lot</th>
                <th class="px-3 py-3">Product</th>
                <th class="px-3 py-3">Stage</th>
                <th class="px-3 py-3">Tool</th>
                <th class="px-3 py-3">Progress</th>
                <th class="px-3 py-3">Status</th>
                <th class="px-3 py-3 text-right">ETA out</th>
                <th class="px-3 py-3"></th>
              </tr>
            </thead>
            <tbody id="lotRows" class="divide-y divide-zinc-100"></tbody>
          </table>
        </div>
      </section>

    </div>
  </main>
</div>

<script>
  // ============ Active lots ============
  const LOTS = [
    { lot: 'W2607-N3',  product: 'Meridian M6',     stage: 'M5 Litho',     tool: 'ASML NXE-01',  pct: 64, status: 'On hold',     eta: 'Jul 02',  flag: 'crit' },
    { lot: 'W2614-N3',  product: 'Meridian M6',     stage: 'M3 Etch',      tool: 'LAM Kiyo-04',  pct: 41, status: 'SPC review',  eta: 'Jul 06',  flag: 'warn' },
    { lot: 'W2589-N4',  product: 'Sinew N2',        stage: 'Gate Implant', tool: 'AMAT Quantum', pct: 28, status: 'Running',     eta: 'Jul 11',  flag: null   },
    { lot: 'W2602-N3',  product: 'Loom D2',         stage: 'M8 CMP',       tool: 'AMAT Reflexion', pct: 78, status: 'Running',   eta: 'Jun 27',  flag: null   },
    { lot: 'W2611-N4',  product: 'Vela SC',         stage: 'M2 Cu Fill',   tool: 'AMAT Endura',  pct: 33, status: 'Running',     eta: 'Jul 09',  flag: null   },
    { lot: 'W2598-N3',  product: 'Loom D2',         stage: 'Final Probe',  tool: 'KLA Archer',   pct: 96, status: 'Running',     eta: 'Jun 16',  flag: 'good' },
    { lot: 'W2620-N4',  product: 'Sinew N2',        stage: 'STI CMP',      tool: 'AMAT Reflexion', pct: 12, status: 'Running',   eta: 'Jul 18',  flag: null   },
  ]
  const FLAG = {
    crit: { pill: 'border-red-200 bg-red-50 text-red-800', dot: 'bg-red-500' },
    warn: { pill: 'border-amber-200 bg-amber-50 text-amber-800', dot: 'bg-amber-500' },
    good: { pill: 'border-emerald-200 bg-emerald-50 text-emerald-800', dot: 'bg-emerald-500' },
    null: { pill: 'border-zinc-200 bg-zinc-50 text-zinc-700', dot: 'bg-zinc-400' },
  }
  const tbody = document.getElementById('lotRows')
  tbody.innerHTML = LOTS.map(l => {
    const f = FLAG[l.flag] || FLAG.null
    return `
      <tr class="group cursor-pointer transition hover:bg-zinc-50" data-lot="${l.lot}">
        <td class="px-5 py-3 text-[13px] font-medium tabular-nums text-zinc-950">${l.lot}</td>
        <td class="px-3 py-3 text-[13px] text-zinc-700">${l.product}</td>
        <td class="px-3 py-3 text-[12.5px] text-zinc-700">${l.stage}</td>
        <td class="px-3 py-3 text-[12.5px] text-zinc-500">${l.tool}</td>
        <td class="px-3 py-3">
          <div class="flex items-center gap-2 min-w-[120px]">
            <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-zinc-100">
              <div class="h-full rounded-full bg-zinc-900" style="width:${l.pct}%"></div>
            </div>
            <span class="w-9 text-right text-[11px] tabular-nums text-zinc-500">${l.pct}%</span>
          </div>
        </td>
        <td class="px-3 py-3">
          <span class="inline-flex items-center gap-1.5 rounded-md border ${f.pill} px-2 py-0.5 text-[11px] font-medium">
            <span class="h-1.5 w-1.5 rounded-full ${f.dot}"></span>${l.status}
          </span>
        </td>
        <td class="px-3 py-3 text-right text-[12.5px] tabular-nums text-zinc-700">${l.eta}</td>
        <td class="px-3 py-3 text-right">
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 text-zinc-400 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg>
        </td>
      </tr>`
  }).join('')
  tbody.querySelectorAll('tr').forEach(tr => tr.addEventListener('click', () => {
    window.location.href = `lot-detail.html?lot=${encodeURIComponent(tr.dataset.lot)}`
  }))

  // ============ Skip link ============
  const skip = document.createElement('a')
  skip.href = '#mainContent'
  skip.textContent = 'Skip to main content'
  skip.className = 'sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-zinc-900 focus:px-3 focus:py-2 focus:text-sm focus:text-white'
  document.body.insertBefore(skip, document.body.firstChild)
  document.querySelector('main').setAttribute('id', 'mainContent')
  document.querySelector('main').setAttribute('tabindex', '-1')

  // ============ Cmd+K ============
  const cmd = document.createElement('div')
  cmd.className = 'fixed inset-0 z-50 hidden items-start justify-center bg-zinc-900/40 backdrop-blur-sm pt-[18vh]'
  cmd.innerHTML = `
    <div class="w-full max-w-md rounded-lg border border-zinc-200 bg-white shadow-2xl">
      <div class="border-b border-zinc-200 px-3 py-2"><input id="ci" type="text" placeholder="Type a command…" class="w-full bg-transparent px-1 py-1.5 text-sm placeholder:text-zinc-400 focus:outline-none" /></div>
      <ul id="cl" class="max-h-72 overflow-y-auto p-1 text-sm"></ul>
      <div class="border-t border-zinc-200 px-3 py-2 text-[11px] text-zinc-500"><kbd class="rounded border border-zinc-200 bg-zinc-50 px-1">↑↓</kbd> navigate · <kbd class="rounded border border-zinc-200 bg-zinc-50 px-1">⏎</kbd> select · <kbd class="rounded border border-zinc-200 bg-zinc-50 px-1">Esc</kbd> close</div>
    </div>`
  document.body.appendChild(cmd)
  const COMMANDS = [
    { label: 'Go to Fab Floor',         run: () => location.href = 'dashboard.html' },
    { label: 'Open Tool Fleet',         run: () => location.href = 'tools.html' },
    { label: 'Open Recipes (canvas)',   run: () => location.href = 'recipe.html' },
    { label: 'Open Wafer Lot W2607-N3', run: () => location.href = 'lot-detail.html?lot=W2607-N3' },
    { label: 'Open Process BOM',        run: () => location.href = 'bom.html' },
    { label: 'Open NXE-02 (down)',      run: () => location.href = 'tool-detail.html' },
  ]
  const ci = cmd.querySelector('#ci'), cl = cmd.querySelector('#cl')
  let active = 0
  function render(f='') {
    const items = COMMANDS.filter(c => c.label.toLowerCase().includes(f.toLowerCase()))
    active = 0
    cl.innerHTML = items.map((c, i) => `<li data-i="${i}" class="cursor-pointer rounded-md px-3 py-2 ${i===0?'bg-zinc-100':''}">${c.label}</li>`).join('') || '<li class="px-3 py-3 text-zinc-400">No matches.</li>'
    cl.querySelectorAll('li[data-i]').forEach(li => {
      li.addEventListener('mouseenter', () => { cl.querySelectorAll('li').forEach(x => x.classList.remove('bg-zinc-100')); li.classList.add('bg-zinc-100'); active = +li.dataset.i })
      li.addEventListener('click', () => items[+li.dataset.i]?.run())
    })
    cl._items = items
  }
  function open() { cmd.classList.remove('hidden'); cmd.classList.add('flex'); ci.value=''; render(''); setTimeout(()=>ci.focus(),0) }
  function close() { cmd.classList.add('hidden'); cmd.classList.remove('flex') }
  ci.addEventListener('input', () => render(ci.value))
  ci.addEventListener('keydown', e => {
    if (e.key==='Escape') { e.preventDefault(); close(); return }
    const items = cl._items || []
    if (e.key==='ArrowDown') { e.preventDefault(); active = Math.min(items.length-1, active+1) }
    else if (e.key==='ArrowUp') { e.preventDefault(); active = Math.max(0, active-1) }
    else if (e.key==='Enter') { e.preventDefault(); items[active]?.run(); return }
    else return
    cl.querySelectorAll('li').forEach((li,i) => li.classList.toggle('bg-zinc-100', i===active))
  })
  cmd.addEventListener('click', e => { if (e.target===cmd) close() })
  window.addEventListener('keydown', e => { if ((e.metaKey||e.ctrlKey)&&(e.key==='k'||e.key==='K')) { e.preventDefault(); cmd.classList.contains('hidden') ? open() : close() } })
</script>

<!-- ============ Constellation globe ============
     Lazy-loaded: globe.gl bundles three.js + d3 + three-globe (~400KB) and
     pulls Earth textures from CDN. Satellites are direct THREE.Group objects
     added to the globe scene; an RAF loop updates their lat/lng each frame
     so they orbit visibly while the globe also auto-rotates. -->
<script type="module">
  const stage = document.getElementById('globeStage')
  const loadingEl = document.getElementById('globeLoading')
  if (stage) {
    try {
      const [GlobeMod, ThreeMod, countries] = await Promise.all([
        import('https://cdn.jsdelivr.net/npm/globe.gl@2.34.4/+esm'),
        import('https://cdn.jsdelivr.net/npm/three@0.149.0/+esm'),
        // Country boundaries for clearer continent definition over the night
        // Earth texture. Falls back to no polygons if the fetch is blocked.
        fetch('https://raw.githubusercontent.com/vasturiano/globe.gl/master/example/datasets/ne_110m_admin_0_countries.geojson')
          .then(r => r.ok ? r.json() : { features: [] })
          .catch(() => ({ features: [] })),
      ])
      const Globe = GlobeMod.default
      const THREE = ThreeMod

      // Ground locations — Kiln fabs, Aetheron DCs, ground stations
      const GROUND = [
        { name: 'Fab 1 · Austin',          lat: 30.27,  lng: -97.74,  kind: 'fab'    },
        { name: 'Aetheron · Palo Alto',    lat: 37.45,  lng: -122.18, kind: 'dc'     },
        { name: 'Aetheron · Hawthorne',    lat: 33.92,  lng: -118.33, kind: 'dc'     },
        { name: 'Aetheron · Boca Chica',   lat: 25.99,  lng: -97.16,  kind: 'launch' },
        { name: 'GS · Andøya',             lat: 69.30,  lng: 16.04,   kind: 'gs'     },
        { name: 'GS · Adelaide',           lat: -34.93, lng: 138.60,  kind: 'gs'     },
        { name: 'GS · Punta Arenas',       lat: -53.16, lng: -70.91,  kind: 'gs'     },
        { name: 'GS · Reykjavík',          lat: 64.13,  lng: -21.94,  kind: 'gs'     },
        { name: 'GS · Singapore',          lat: 1.35,   lng: 103.82,  kind: 'gs'     },
        { name: 'GS · Bahrain',            lat: 26.07,  lng: 50.55,   kind: 'gs'     },
      ]

      // 28 satellites — most nominal, a couple degraded, one offline
      const NUM = 28
      const SATS = Array.from({ length: NUM }, (_, i) => ({
        id:      'SC-' + (1024 + i),
        baseLng: (Math.random() * 360) - 180,
        lat:     (Math.random() - 0.5) * 130,           // ±65° inclination
        alt:     0.42 + Math.random() * 0.30,           // ~LEO band
        speed:   8 + Math.random() * 6,                 // deg/sec along orbit
        dir:     Math.random() < 0.6 ? 1 : -1,
        status:  i < 25 ? 'ok' : i < 27 ? 'warn' : 'off',
      }))

      const globe = Globe({ animateIn: true })(stage)
        .globeImageUrl('https://cdn.jsdelivr.net/npm/three-globe@2.31.1/example/img/earth-night.jpg')
        .bumpImageUrl('https://cdn.jsdelivr.net/npm/three-globe@2.31.1/example/img/earth-topology.png')
        .backgroundColor('rgba(0,0,0,0)')
        .showAtmosphere(true)
        .atmosphereColor('#3b82f6')
        .atmosphereAltitude(0.18)
        // Country polygons — subtle cyan wash on land + brighter borders so
        // continents are clearly readable on the otherwise low-contrast night
        // Earth texture.
        .polygonsData(countries.features || [])
        .polygonCapColor(() => 'rgba(56, 189, 248, 0.14)')
        .polygonSideColor(() => 'rgba(0, 0, 0, 0)')
        .polygonStrokeColor(() => 'rgba(125, 211, 252, 0.70)')
        .polygonAltitude(0.004)
        .pointOfView({ lat: 25, lng: -90, altitude: 2.5 }, 0)

      // Ground points — white halo + colored dot (so dots stay legible on
      // bright land + dark ocean)
      const groundColor = (k) =>
        k === 'fab'    ? '#22d3ee' :
        k === 'launch' ? '#ef4444' :
        k === 'dc'     ? '#fbbf24' :
                         '#67e8f9'
      const haloPoints = GROUND.map(p => ({ ...p, _color: '#ffffff', _size: 1.4, _alt: 0.005 }))
      const dotPoints  = GROUND.map(p => ({ ...p, _color: groundColor(p.kind), _size: 0.7, _alt: 0.012 }))

      globe
        .pointsData([...haloPoints, ...dotPoints])
        .pointLat('lat').pointLng('lng')
        .pointColor('_color')
        .pointAltitude('_alt')
        .pointRadius('_size')
        .pointLabel(p => p._color === '#ffffff' ? '' : `
          <div style="background:rgba(20,24,32,0.92);color:white;padding:8px 12px;border-radius:8px;border:0.5px solid rgba(255,255,255,0.12);font:12px Inter,sans-serif;letter-spacing:-0.005em;box-shadow:0 8px 24px rgba(0,0,0,0.4)">
            <div style="font-weight:600">${p.name}</div>
            <div style="color:rgba(255,255,255,0.55);font-size:10.5px;margin-top:1px">${p.kind === 'fab' ? 'Kiln fab' : p.kind === 'launch' ? 'Launch site' : p.kind === 'dc' ? 'Data center' : 'Ground station'}</div>
          </div>
        `)
        // Pulse ring on each Kiln fab — that's the source of the silicon
        .ringsData(GROUND.filter(p => p.kind === 'fab').map(p => ({ ...p, _maxR: 5 })))
        .ringLat('lat').ringLng('lng')
        .ringColor(() => t => `rgba(34,211,238,${1 - t})`)
        .ringMaxRadius('_maxR')
        .ringPropagationSpeed(1.4)
        .ringRepeatPeriod(2200)

      // ============ Satellites ============
      // Direct THREE.Group objects added to the globe scene. Updated on RAF.
      const matOk    = new THREE.MeshLambertMaterial({ color: 0xa3e635, emissive: 0x365314, emissiveIntensity: 0.55 })
      const matWarn  = new THREE.MeshLambertMaterial({ color: 0xfbbf24, emissive: 0x78350f, emissiveIntensity: 0.55 })
      const matOff   = new THREE.MeshLambertMaterial({ color: 0x52525b, emissive: 0x18181b, emissiveIntensity: 0.20 })
      const matPanel = new THREE.MeshLambertMaterial({ color: 0x60a5fa, emissive: 0x1e3a8a, emissiveIntensity: 0.35, transparent: true, opacity: 0.92 })

      const bodyGeo  = new THREE.BoxGeometry(1.5, 1.5, 2.1)
      const panelGeo = new THREE.BoxGeometry(6.0, 0.24, 1.5)

      const SAT_OBJS = SATS.map(s => {
        const grp = new THREE.Group()
        const body = new THREE.Mesh(bodyGeo, s.status === 'ok' ? matOk : s.status === 'warn' ? matWarn : matOff)
        const lp = new THREE.Mesh(panelGeo, matPanel); lp.position.x =  3.5
        const rp = new THREE.Mesh(panelGeo, matPanel); rp.position.x = -3.5
        grp.add(body, lp, rp)
        return { ...s, obj: grp }
      })

      const scene = globe.scene()
      SAT_OBJS.forEach(s => scene.add(s.obj))

      // ============ K-Anchor — orbital data center ============
      // Distinct from the satellite swarm: 5 stacked compute modules along a
      // central spine, two large solar arrays, two radiator fins. Higher,
      // slower orbit so it visually leads the swarm.
      function buildDC() {
        const grp = new THREE.Group()
        const modMat = new THREE.MeshLambertMaterial({ color: 0xe5e7eb, emissive: 0x1f2937, emissiveIntensity: 0.45 })
        const modGeo = new THREE.BoxGeometry(1.9, 1.65, 1.65)
        for (let i = 0; i < 5; i++) {
          const m = new THREE.Mesh(modGeo, modMat)
          m.position.x = (i - 2) * 2.0
          grp.add(m)
        }
        const panelMat = new THREE.MeshLambertMaterial({ color: 0x38bdf8, emissive: 0x0c4a6e, emissiveIntensity: 0.55, transparent: true, opacity: 0.95 })
        const panelGeo = new THREE.BoxGeometry(15, 0.26, 3.3)
        const ptop = new THREE.Mesh(panelGeo, panelMat); ptop.position.z =  2.8
        const pbot = new THREE.Mesh(panelGeo, panelMat); pbot.position.z = -2.8
        grp.add(ptop, pbot)
        const radMat = new THREE.MeshLambertMaterial({ color: 0xf59e0b, emissive: 0x92400e, emissiveIntensity: 0.5 })
        const radGeo = new THREE.BoxGeometry(0.26, 1.65, 1.65)
        const rtop = new THREE.Mesh(radGeo, radMat); rtop.position.y =  1.65
        const rbot = new THREE.Mesh(radGeo, radMat); rbot.position.y = -1.65
        grp.add(rtop, rbot)
        return grp
      }
      const DC = {
        id:      'K-Anchor',
        baseLng: 0,
        lat:     5,        // shallow inclination, near equator
        alt:     0.95,     // higher than the LEO swarm
        speed:   4,        // slower
        dir:     1,
        obj:     buildDC(),
      }
      scene.add(DC.obj)

      function tick() {
        const t = performance.now() / 1000
        ;[...SAT_OBJS, DC].forEach(s => {
          const lng = ((s.baseLng + s.dir * s.speed * t * 0.6) % 360 + 540) % 360 - 180
          const c = globe.getCoords(s.lat, lng, s.alt)
          s.obj.position.set(c.x, c.y, c.z)
          s.obj.lookAt(0, 0, 0)
        })
        requestAnimationFrame(tick)
      }
      tick()

      // Auto-rotate (slow)
      const ctrls = globe.controls()
      ctrls.autoRotate = true
      ctrls.autoRotateSpeed = 0.3
      ctrls.enableZoom = false

      // ============ Click-to-inspect ============
      // Raycast pointer events against satellite + K-Anchor meshes (globe.gl
      // doesn't pick raw THREE meshes added to its scene). Every child mesh
      // stores a backref to its owning record so we can render the info card.
      const clickables = []
      SAT_OBJS.forEach(s => s.obj.traverse(m => {
        if (m.isMesh) { m.userData.pick = { kind: 'sat', ref: s }; clickables.push(m) }
      }))
      DC.obj.traverse(m => {
        if (m.isMesh) { m.userData.pick = { kind: 'anchor', ref: DC }; clickables.push(m) }
      })

      const raycaster = new THREE.Raycaster()
      const ndc = new THREE.Vector2()
      const canvas = globe.renderer().domElement

      function pick(clientX, clientY) {
        const rect = canvas.getBoundingClientRect()
        ndc.x =  ((clientX - rect.left) / rect.width)  * 2 - 1
        ndc.y = -((clientY - rect.top)  / rect.height) * 2 + 1
        raycaster.setFromCamera(ndc, globe.camera())
        const hits = raycaster.intersectObjects(clickables, false)
        return hits.length ? hits[0].object.userData.pick : null
      }

      canvas.addEventListener('mousemove', e => {
        canvas.style.cursor = pick(e.clientX, e.clientY) ? 'pointer' : ''
      })

      const card = document.getElementById('orbitCard')
      const cardEl = {
        id:      document.getElementById('orbitCardId'),
        kind:    document.getElementById('orbitCardKind'),
        status:  document.getElementById('orbitCardStatus'),
        silicon: document.getElementById('orbitCardSilicon'),
        alt:     document.getElementById('orbitCardAlt'),
        incl:    document.getElementById('orbitCardIncl'),
        uplink:  document.getElementById('orbitCardUplink'),
      }
      const STATUS_LABEL = { ok: 'Nominal', warn: 'Degraded', off: 'Offline' }
      const STATUS_COLOR = { ok: 'text-emerald-300', warn: 'text-amber-300', off: 'text-zinc-400' }
      const GS = ['Andøya', 'Adelaide', 'Punta Arenas', 'Reykjavík', 'Singapore', 'Bahrain']

      function altKm(alt) { return Math.round(500 + alt * 800) + ' km' }

      canvas.addEventListener('click', e => {
        const p = pick(e.clientX, e.clientY)
        if (!p) { card.classList.add('hidden'); return }
        card.classList.remove('hidden')
        if (p.kind === 'sat') {
          const s = p.ref
          const seed = parseInt(s.id.slice(3), 10)
          cardEl.id.textContent      = s.id
          cardEl.kind.textContent    = 'Vela SC Node'
          cardEl.status.className    = 'font-semibold ' + STATUS_COLOR[s.status]
          cardEl.status.textContent  = STATUS_LABEL[s.status]
          cardEl.silicon.textContent = 'Kiln N3E'
          cardEl.alt.textContent     = altKm(s.alt)
          cardEl.incl.textContent    = Math.abs(Math.round(s.lat)) + '°'
          cardEl.uplink.textContent  = s.status === 'off'
            ? '— no lock —'
            : 'GS-' + GS[seed % GS.length] + ' · ' + (((seed * 7) % 40) + 3) + 's ago'
        } else {
          cardEl.id.textContent      = 'K-Anchor'
          cardEl.kind.textContent    = 'Orbital data center'
          cardEl.status.className    = 'font-semibold text-emerald-300'
          cardEl.status.textContent  = 'Nominal'
          cardEl.silicon.textContent = 'Kiln N3E · Loom D2'
          cardEl.alt.textContent     = altKm(DC.alt)
          cardEl.incl.textContent    = Math.abs(DC.lat) + '°'
          cardEl.uplink.textContent  = 'Mesh · 6 GS'
        }
      })

      document.getElementById('orbitCardClose').addEventListener('click', () => card.classList.add('hidden'))
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && !card.classList.contains('hidden')) card.classList.add('hidden')
      })

      // Resize handler
      const sizeGlobe = () => globe.width(stage.clientWidth).height(stage.clientHeight)
      sizeGlobe()
      window.addEventListener('resize', sizeGlobe)

      if (loadingEl) loadingEl.style.display = 'none'
    } catch (err) {
      console.error('Constellation globe failed to load:', err)
      if (loadingEl) loadingEl.textContent = 'Globe failed to load — check console'
    }
  }
</script>

</body>
</html>
